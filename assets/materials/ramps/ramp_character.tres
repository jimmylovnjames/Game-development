[gd_resource type="GradientTexture1D" load_steps=2 format=3]

; Three-band character ramp. Constant interpolation gives the hard terminator
; the style bible asks for; the colour drift across the bands is the reason to
; use a ramp at all rather than a numeric band count — shadow goes cold violet
; and the lit end warms slightly, which analytic banding cannot express.

[sub_resource type="Gradient" id="Gradient_character"]
interpolation_mode = 1
offsets = PackedFloat32Array(0, 0.42, 0.72)
colors = PackedColorArray(0.24, 0.2, 0.42, 1, 0.6, 0.58, 0.7, 1, 0.93, 0.91, 0.86, 1)

[resource]
resource_name = "ramp_character"
gradient = SubResource("Gradient_character")
width = 64
