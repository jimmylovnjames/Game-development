[resource]
script = ExtResource("2_hlbwa")
id = &"mq01_the_transit_pass"
title = "The Transit Pass"
logline = "Someone paid off your debt. Nobody does that for free."
briefing = "Vex says the debt is cleared and hands you a sealed transit pass
for the Ferrum Halo spine line. She will not say who bought it. The pass expires
at dawn, and the only people who can tell you whose name is on it are the ones
who will want it back."
act = 1
giver_id = &"npc_vex"
district_id = &"district_lowspine"
objectives = Array[ExtResource("1_vjc73")]([SubResource("Resource_g1jnn"), SubResource("Resource_myhx6"), SubResource("Resource_grail")])
flags_on_complete = Array[StringName]([&"mq01_resolved"])
outcomes = Array[StringName]([&"boarded_with_the_pass", &"sold_the_pass_to_the_syndicate", &"burned_the_pass"])
outcome_notes = "boarded_with_the_pass — you owe Halcyon Collection, and they will collect in Act 2.
sold_the_pass_to_the_syndicate — solvent, stranded, and two ledgers just updated.
burned_the_pass — nobody owns you; Halcyon writes off a purchased debt. Locks the spine line.
Optional read_the_pass (Nix the forger) does not add a fourth ending — it rewrites the price list so every branch names the buyer."
